rules_version = '2';
// PG Derma Companion — security rules.
// Access is by Google sign-in + manual approval by the admin. Patient data is never stored here
// (cloud sync goes, encrypted, to each user's own Google Drive). Firestore holds only:
//   approvals/{uid}  — access requests;  batches/** — batch calendar, group chat, member names, anonymous procedure counts.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null && request.auth.token.email_verified == true; }
    function isAdminUser() { return signedIn() && request.auth.token.email in ['sriramdeverashetty@gmail.com']; }
    function approved() {
      return isAdminUser() || (signedIn()
        && exists(/databases/$(database)/documents/approvals/$(request.auth.uid))
        && get(/databases/$(database)/documents/approvals/$(request.auth.uid)).data.status == 'approved');
    }
    function isMember(b) { return approved() && exists(/databases/$(database)/documents/batches/$(b)/members/$(request.auth.uid)); }
    function isAdmin(b) { return approved() && request.auth.uid in get(/databases/$(database)/documents/batches/$(b)).data.admins; }
    // Calling is off by default; the admin switches it on per person (approvals/{uid}.calls == true).
    function canCall(u) {
      return exists(/databases/$(database)/documents/approvals/$(u))
        && get(/databases/$(database)/documents/approvals/$(u)).data.get('calls', false) == true;
    }
    function shortStr(v, n) { return v is string && v.size() <= n; }

    // Access requests. A user can only file their own request as "pending"; only the admin decides.
    match /approvals/{u} {
      allow get: if signedIn() && (u == request.auth.uid || isAdminUser());
      allow list: if isAdminUser();
      allow create: if (isAdminUser() && request.resource.data.keys().hasOnly(['email', 'name', 'photo', 'status', 'requestedAt', 'decidedAt', 'decidedBy', 'calls']))
        || (signedIn() && u == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.keys().hasOnly(['email', 'name', 'photo', 'status', 'requestedAt', 'college', 'year', 'ref'])
        && shortStr(request.resource.data.name, 120) && shortStr(request.resource.data.photo, 500)
        && (!('college' in request.resource.data) || shortStr(request.resource.data.college, 80))
        && (!('year' in request.resource.data) || request.resource.data.year in ['JR1', 'JR2', 'JR3', 'SR', 'Faculty', 'Aspirant'])
        && (!('ref' in request.resource.data) || (request.resource.data.ref is string && request.resource.data.ref.matches('^[A-Za-z0-9]{4,20}$'))));
      allow update: if isAdminUser()
        && request.resource.data.status in ['pending', 'approved', 'rejected']
        && request.resource.data.keys().hasOnly(['email', 'name', 'photo', 'status', 'requestedAt', 'decidedAt', 'decidedBy', 'calls', 'college', 'year', 'ref'])
        && (!('calls' in request.resource.data) || request.resource.data.calls is bool);
      allow delete: if isAdminUser();
    }

    // Error reports (scrubbed, no patient data): approved users write their own; only the admin reads.
    match /errors/{e} {
      allow create: if approved() && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['type', 'msg', 'stack', 'route', 'version', 'ua', 'at', 'uid', 'createdAt'])
        && shortStr(request.resource.data.msg, 300) && shortStr(request.resource.data.stack, 900)
        && shortStr(request.resource.data.route, 60) && shortStr(request.resource.data.ua, 160);
      allow read, delete: if isAdminUser();
    }

    // Monthly call-relay estimate for the admin page.
    // Study content: the bot drafts (status "draft"); only the admin sees drafts and publishes them ("live").
    match /content/{c} {
      allow get, list: if isAdminUser() || (approved() && resource.data.status == 'live');
      allow update: if isAdminUser()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'approvedAt', 'q', 'o', 'a', 'x', 'r', 'f', 'b', 'v', 'dx', 'p', 'top'])
        && request.resource.data.status in ['draft', 'live'];
      allow delete: if isAdminUser();
    }
    // Direct calls (no batch needed): the admin can call any approved resident; residents can call each other when the admin has switched calling on for both. Media never touches Firestore.
    match /dcalls/{c} {
      function dparty() { return resource.data.caller == request.auth.uid || resource.data.callee == request.auth.uid; }
      allow read: if signedIn() && dparty();
      allow create: if (isAdminUser() || (canCall(request.auth.uid) && canCall(request.resource.data.callee))) && request.resource.data.caller == request.auth.uid
        && request.resource.data.callee != request.auth.uid
        && request.resource.data.status == 'ringing'
        && request.resource.data.keys().hasOnly(['caller', 'callerName', 'callee', 'calleeName', 'video', 'status', 'offer', 'createdAt'])
        && shortStr(request.resource.data.callerName, 80) && shortStr(request.resource.data.calleeName, 80);
      allow update: if approved() && dparty()
        && request.resource.data.caller == resource.data.caller && request.resource.data.callee == resource.data.callee
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['answer', 'status', 'endedAt']);
      allow delete: if isAdminUser();
      match /cands/{x} {
        function dinCall() { let call = get(/databases/$(database)/documents/dcalls/$(c)).data; return call.caller == request.auth.uid || call.callee == request.auth.uid; }
        allow read: if signedIn() && dinCall();
        allow create: if approved() && dinCall() && request.resource.data.keys().hasOnly(['from', 'c']) && request.resource.data.from in ['caller', 'callee'];
        allow delete: if isAdminUser();
      }
    }
    // Community (all approved users). Posts go live at once; anyone can report; the admin deletes or revokes.
    function pkeys() { return ['uid', 'name', 'year', 'kind', 'text', 'tags', 'img', 'likes', 'comments', 'reports', 'createdAt']; }
    function step(f) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly([f]) && (request.resource.data[f] == resource.data[f] + 1 || request.resource.data[f] == resource.data[f] - 1); }
    match /posts/{p} {
      allow read: if approved();
      allow create: if approved() && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(pkeys())
        && request.resource.data.kind in ['case', 'question', 'pearl']
        && request.resource.data.text is string && request.resource.data.text.size() >= 10 && request.resource.data.text.size() <= 3000
        && request.resource.data.tags is list && request.resource.data.tags.size() <= 3
        && (!('img' in request.resource.data) || (request.resource.data.img is string && request.resource.data.img.size() < 450000 && request.resource.data.img.matches('data:image/jpeg;base64,.*')))
        && request.resource.data.likes == 0 && request.resource.data.comments == 0 && request.resource.data.reports == 0
        && request.resource.data.createdAt == request.time && shortStr(request.resource.data.name, 80);
      allow update: if approved() && (step('likes') || step('comments'));
      allow delete: if isAdminUser() || (approved() && resource.data.uid == request.auth.uid);
      match /likes/{u} {
        allow read: if approved();
        allow create, delete: if approved() && u == request.auth.uid;
      }
    }
    match /threads/{t}/c/{c} {
      allow read: if approved();
      allow create: if approved() && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'name', 'text', 'at'])
        && request.resource.data.text is string && request.resource.data.text.size() >= 1 && request.resource.data.text.size() <= 1000
        && request.resource.data.at == request.time && shortStr(request.resource.data.name, 80);
      allow delete: if isAdminUser() || (approved() && resource.data.uid == request.auth.uid);
    }
    match /reports/{r} {
      allow create: if approved() && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['post', 'uid', 'reason', 'at']) && shortStr(request.resource.data.reason, 300);
      allow read, delete: if isAdminUser();
    }
    match /profiles/{u} {
      allow read: if approved();
      allow create, update: if approved() && u == request.auth.uid
        && request.resource.data.keys().hasOnly(['name', 'year', 'college', 'bio', 'streak', 'best', 'total', 'xp', 'posts', 'photo', 'updatedAt'])
        && (!('photo' in request.resource.data) || (request.resource.data.photo is string && request.resource.data.photo.size() < 70000))
        && shortStr(request.resource.data.name, 80) && shortStr(request.resource.data.college, 80) && shortStr(request.resource.data.bio, 200)
        && request.resource.data.xp is map && request.resource.data.xp.size() <= 4
        && request.resource.data.total is int && request.resource.data.streak is int;
      allow delete: if isAdminUser() || (signedIn() && u == request.auth.uid);
    }
    // Social: follows, notifications, DMs, stories (24 h, polls/quizzes), push tokens, app config.
    match /follows/{id} {
      allow read: if approved();
      allow create: if approved() && request.resource.data.a == request.auth.uid && id == request.auth.uid + '_' + request.resource.data.b
        && request.resource.data.keys().hasOnly(['a', 'b', 'at']) && request.resource.data.b != request.auth.uid;
      allow delete: if approved() && resource.data.a == request.auth.uid;
    }
    match /notifs/{id} {
      allow read: if signedIn() && resource.data.to == request.auth.uid;
      allow create: if approved() && request.resource.data.from == request.auth.uid && request.resource.data.to != request.auth.uid
        && request.resource.data.keys().hasOnly(['to', 'from', 'fromName', 'type', 'ref', 'text', 'at', 'read', 'pushed'])
        && request.resource.data.type in ['like', 'comment', 'follow', 'dm', 'call', 'vote', 'refer']
        && request.resource.data.read == false && request.resource.data.pushed == false
        && shortStr(request.resource.data.fromName, 80) && shortStr(request.resource.data.text, 160) && shortStr(request.resource.data.ref, 120);
      allow update: if signedIn() && resource.data.to == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow delete: if isAdminUser() || (signedIn() && resource.data.to == request.auth.uid);
    }
    match /dms/{cid} {
      function mem() { return request.auth.uid in resource.data.members; }
      allow read: if approved() && mem();
      allow create: if approved() && request.auth.uid in request.resource.data.members && request.resource.data.members.size() == 2
        && cid == request.resource.data.members[0] + '_' + request.resource.data.members[1]
        && request.resource.data.keys().hasOnly(['members', 'names', 'last', 'lastAt', 'unread']);
      allow update: if approved() && mem() && request.resource.data.members == resource.data.members
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['last', 'lastAt', 'unread', 'names']);
      allow delete: if isAdminUser();
      match /m/{m} {
        function dmem() { return request.auth.uid in get(/databases/$(database)/documents/dms/$(cid)).data.members; }
        allow read: if approved() && dmem();
        allow create: if approved() && dmem() && request.resource.data.uid == request.auth.uid
          && request.resource.data.keys().hasOnly(['uid', 'text', 'at']) && request.resource.data.text is string
          && request.resource.data.text.size() >= 1 && request.resource.data.text.size() <= 2000 && request.resource.data.at == request.time;
        allow delete: if isAdminUser() || (approved() && resource.data.uid == request.auth.uid);
      }
    }
    match /stories/{s} {
      allow read: if approved();
      allow create: if approved() && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'name', 'kind', 'text', 'img', 'opts', 'ans', 'createdAt'])
        && request.resource.data.kind in ['photo', 'text', 'poll', 'quiz'] && shortStr(request.resource.data.text, 300) && shortStr(request.resource.data.name, 80)
        && (!('img' in request.resource.data) || (request.resource.data.img is string && request.resource.data.img.size() < 450000 && request.resource.data.img.matches('data:image/jpeg;base64,.*')))
        && (!('opts' in request.resource.data) || (request.resource.data.opts is list && request.resource.data.opts.size() <= 4))
        && request.resource.data.createdAt == request.time;
      allow delete: if isAdminUser() || (approved() && resource.data.uid == request.auth.uid);
      match /votes/{u} {
        allow read: if approved();
        allow create: if approved() && u == request.auth.uid && request.resource.data.keys().hasOnly(['o', 'at']) && request.resource.data.o is int;
      }
    }
    match /pushTokens/{u} {
      allow read, write: if signedIn() && u == request.auth.uid;
    }
    match /config/{c} {
      allow read: if signedIn();
      allow write: if isAdminUser();
    }
    // Study streak summary, so the reminder bot knows whom to nudge. No study answers or patient data.
    match /study/{u} {
      allow get: if signedIn() && (u == request.auth.uid || isAdminUser());
      allow list: if isAdminUser();
      allow create, update: if approved() && u == request.auth.uid
        && request.resource.data.keys().hasOnly(['name', 'email', 'streak', 'last', 'goal', 'remind', 'hour', 'tz', 'updatedAt'])
        && request.resource.data.email == request.auth.token.email
        && shortStr(request.resource.data.name, 80) && request.resource.data.remind is bool
        && request.resource.data.hour is int && request.resource.data.hour >= 0 && request.resource.data.hour <= 23;
      allow delete: if signedIn() && (u == request.auth.uid || isAdminUser());
    }
    match /usage/{m} {
      allow read: if isAdminUser();
      allow create, update: if approved() && request.resource.data.keys().hasOnly(['relayMB', 'relayCalls', 'updatedAt'])
        && request.resource.data.relayMB is int && request.resource.data.relayCalls is int;
    }

    match /batches/{b} {
      // The batch ID is the secret invite code (DVL-XXXX-XXXX). Approved users may look up a code they know,
      // but nobody can list batches.
      allow get: if approved();
      allow list: if isAdminUser();
      allow create: if approved()
        && b.matches('DVL-[A-Z0-9]{4}-[A-Z0-9]{4}')
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.admins == [request.auth.uid]
        && shortStr(request.resource.data.name, 120);
      allow update: if isAdmin(b) && request.resource.data.createdBy == resource.data.createdBy;
      allow delete: if isAdminUser() || isAdmin(b);

      match /members/{u} {
        allow read: if isMember(b) || isAdminUser();
        allow create, update: if approved() && u == request.auth.uid
          && exists(/databases/$(database)/documents/batches/$(b))
          && request.resource.data.keys().hasOnly(['name', 'year', 'joinedAt'])
          && shortStr(request.resource.data.name, 80) && shortStr(request.resource.data.year, 10);
        allow delete: if signedIn() && (u == request.auth.uid || isAdmin(b) || isAdminUser());
      }

      match /events/{e} {
        allow read: if isMember(b) || isAdminUser();
        allow create: if isMember(b)
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.keys().hasOnly(['title', 'type', 'date', 'time', 'presenter', 'venue', 'notes', 'createdBy', 'createdAt'])
          && shortStr(request.resource.data.title, 150) && shortStr(request.resource.data.type, 40)
          && request.resource.data.date is string && request.resource.data.date.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
          && shortStr(request.resource.data.time, 5) && shortStr(request.resource.data.presenter, 80)
          && shortStr(request.resource.data.venue, 80) && shortStr(request.resource.data.notes, 300);
        allow delete: if isAdminUser() || (isMember(b) && (resource.data.createdBy == request.auth.uid || isAdmin(b)));
        allow update: if false;
      }

      // Batch group chat. Members only; you post as yourself; delete your own (admin: any); no edits.
      match /messages/{m} {
        allow read: if isMember(b) || isAdminUser();
        allow create: if isMember(b)
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.keys().hasOnly(['uid', 'name', 'text', 'at'])
          && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 1000
          && shortStr(request.resource.data.name, 80)
          && request.resource.data.at == request.time;
        allow delete: if isAdminUser() || (isMember(b) && (resource.data.uid == request.auth.uid || isAdmin(b)));
        allow update: if false;
      }

      // Online status: members see who has the app open; you only write your own heartbeat.
      match /presence/{u} {
        allow read: if isMember(b) || isAdminUser();
        allow create, update: if isMember(b) && u == request.auth.uid
          && request.resource.data.keys().hasOnly(['name', 'at', 'calls']) && shortStr(request.resource.data.name, 80);
        allow delete: if signedIn() && (u == request.auth.uid || isAdmin(b) || isAdminUser());
      }

      // 1:1 calls: only the two people on a call can see it. Media never touches Firestore.
      match /calls/{c} {
        function party() { return resource.data.caller == request.auth.uid || resource.data.callee == request.auth.uid; }
        allow read: if isMember(b) && party();
        allow create: if isMember(b)
          && request.resource.data.caller == request.auth.uid
          && request.resource.data.callee != request.auth.uid
          && canCall(request.auth.uid) && canCall(request.resource.data.callee)
          && exists(/databases/$(database)/documents/batches/$(b)/members/$(request.resource.data.callee))
          && request.resource.data.status == 'ringing'
          && request.resource.data.keys().hasOnly(['caller', 'callerName', 'callee', 'calleeName', 'video', 'status', 'offer', 'createdAt'])
          && shortStr(request.resource.data.callerName, 80) && shortStr(request.resource.data.calleeName, 80);
        allow update: if isMember(b) && party() && canCall(request.auth.uid)
          && request.resource.data.caller == resource.data.caller && request.resource.data.callee == resource.data.callee
          && request.resource.data.status in ['ringing', 'accepted', 'declined', 'ended', 'missed', 'busy']
          && request.resource.data.keys().hasOnly(['caller', 'callerName', 'callee', 'calleeName', 'video', 'status', 'offer', 'answer', 'createdAt', 'endedAt']);
        allow delete: if isAdminUser() || isAdmin(b) || (isMember(b) && resource.data.caller == request.auth.uid);
        match /cands/{x} {
          function inCall() {
            let call = get(/databases/$(database)/documents/batches/$(b)/calls/$(c)).data;
            return call.caller == request.auth.uid || call.callee == request.auth.uid;
          }
          allow read: if isMember(b) && inCall();
          allow create: if isMember(b) && inCall() && request.resource.data.keys().hasOnly(['from', 'c'])
            && request.resource.data.from in ['caller', 'callee'];
          allow delete: if isAdminUser() || isAdmin(b) || (isMember(b) && inCall());
        }
      }

      // Group calls (up to 4). Only the people listed in the room can see or join it; everyone must have calling on.
      match /rooms/{r} {
        function roomPeople() { return get(/databases/$(database)/documents/batches/$(b)/rooms/$(r)).data.people; }
        function inRoom() { return request.auth.uid in roomPeople(); }
        allow read: if isMember(b) && request.auth.uid in resource.data.people;
        allow create: if isMember(b)
          && request.resource.data.keys().hasOnly(['host', 'hostName', 'people', 'names', 'video', 'status', 'createdAt'])
          && request.resource.data.host == request.auth.uid
          && request.resource.data.people is list
          && request.resource.data.people.size() >= 2 && request.resource.data.people.size() <= 4
          && request.resource.data.people[0] == request.auth.uid
          && canCall(request.auth.uid) && canCall(request.resource.data.people[1])
          && (request.resource.data.people.size() < 3 || canCall(request.resource.data.people[2]))
          && (request.resource.data.people.size() < 4 || canCall(request.resource.data.people[3]))
          && request.resource.data.status == 'live' && request.resource.data.video is bool
          && shortStr(request.resource.data.hostName, 80) && request.resource.data.names is map;
        allow update: if isMember(b) && request.auth.uid in resource.data.people
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'endedAt'])
          && request.resource.data.status == 'ended';
        allow delete: if isAdminUser() || isAdmin(b);

        match /peers/{u} {
          allow read: if isMember(b) && inRoom();
          allow create, update: if isMember(b) && u == request.auth.uid && inRoom() && canCall(request.auth.uid)
            && request.resource.data.keys().hasOnly(['name', 'sid', 'video', 'at']) && shortStr(request.resource.data.name, 80);
          allow delete: if signedIn() && (u == request.auth.uid || isAdmin(b) || isAdminUser());
        }
        match /sig/{p} {
          allow read: if isMember(b) && inRoom();
          allow create, update: if isMember(b) && inRoom() && request.resource.data.keys().hasOnly(['offer', 'answer']);
          allow delete: if isAdminUser() || isAdmin(b);
          match /cands/{x} {
            allow read: if isMember(b) && inRoom();
            allow create: if isMember(b) && inRoom() && request.resource.data.keys().hasOnly(['from', 'c']) && request.resource.data.from == request.auth.uid;
            allow delete: if isAdminUser() || isAdmin(b);
          }
        }
      }

      match /logstats/{u} {
        allow read: if isMember(b) || isAdminUser();
        allow create, update: if isMember(b) && u == request.auth.uid
          && request.resource.data.keys().hasOnly(['counts', 'updatedAt'])
          && request.resource.data.counts is map;
        allow delete: if signedIn() && (u == request.auth.uid || isAdmin(b) || isAdminUser());
      }
    }
  }
}
